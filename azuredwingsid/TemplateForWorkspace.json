			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "--------------------------------\n-- DATABASE SCOPED CREDENTIALS\n--------------------------------\n\nCREATE DATABASE SCOPED CREDENTIAL sid_creds\nWITH IDENTITY='Managed Identity'\n\n---------------------------------\n-- EXTERNAL DATA SOURCE\n---------------------------------\n-- DROP EXTERNAL DATA SOURCE silver_source\n\nCREATE EXTERNAL DATA SOURCE silver_source\nWITH\n(\n    LOCATION = 'https://azuredwhlakesid.dfs.core.windows.net/silver/',\n    CREDENTIAL= sid_creds\n)\n\nCREATE EXTERNAL DATA SOURCE gold_source\nWITH\n(\n    LOCATION = 'https://azuredwhlakesid.dfs.core.windows.net/gold/',\n    CREDENTIAL= sid_creds\n)\n\n-------------------------\n-- External File Format\n-------------------------\nCREATE EXTERNAL FILE FORMAT parquet\nWITH\n(  \n    FORMAT_TYPE = PARQUET,\n    DATA_COMPRESSION = 'org.apache.hadoop.io.compress.SnappyCodec'\n)\n\nCREATE EXTERNAL FILE FORMAT delta\nWITH\n(  \n    FORMAT_TYPE = DELTA,\n)\n",
