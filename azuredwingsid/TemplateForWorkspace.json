			"properties": {
				"content": {
					"query": "If  NOT EXISTS(SELECT * FROM sys.tables t JOIN sys.schemas s on t.schema_id=s.schema_id\nWHERE t.name='silverTable' AND s.name='silver')\n\nCREATE EXTERNAL TABLE silver.silverTable\n(\n    OrderID VARCHAR(100),\n    OrderDate DATETIME2,\n    CustomerID VARCHAR(100),\n    CustomerName VARCHAR(100),\n    CustomerEmail VARCHAR(100),\n    ProductId  VARCHAR(100),\n    ProductName VARCHAR(100),\n    ProductCategory VARCHAR(100),\n    RegionID VARCHAR(100),\n    RegionName VARCHAR(100),\n    Country VARCHAR(100),\n    Quantity VARCHAR(100),\n    UnitPrice INT,\n    TotalAmount INT,\n    Domain VARCHAR(100)\n)\nWITH\n(\n    LOCATION = 'enrichedSales',\n    DATA_SOURCE = silver_source,\n    FILE_FORMAT = parquet\n)",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
