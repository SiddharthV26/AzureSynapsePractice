			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'azuredwingsid-WorkspaceDefaultSqlServer'",
			"defaultValue": "Integrated Security=False;Encrypt=True;Connection Timeout=30;Data Source=tcp:azuredwingsid.sql.azuresynapse.net,1433;Initial Catalog=@{linkedService().DBName}"
		},
		"ExtLake_properties_typeProperties_url": {
			"type": "string",
